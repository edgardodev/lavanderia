generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum ServiceMode {
  SELF_SERVICE
  DONE_FOR_YOU
}

enum CycleType {
  WASH
  DRY
  FULL
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  QUEUED
  PRE_WASH
  WASHING
  DRYING
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

enum MachineSlotType {
  RESERVATION
  ADMIN_BLOCK
}

model User {
  id                        String   @id @default(cuid())
  name                      String
  email                     String   @unique
  phone                     String?
  passwordHash              String
  role                      Role     @default(CLIENT)
  isActive                  Boolean  @default(true)
  canManageAdmins           Boolean  @default(false)
  failedLoginAttempts       Int      @default(0)
  lockedUntil               DateTime?
  mustChangePassword        Boolean  @default(false)
  passwordChangedAt         DateTime?
  sessionVersion            Int      @default(0)
  lastLoginAt               DateTime?
  mfaEnabled                Boolean  @default(false)
  mfaSecretEncrypted        String?  @db.Text
  mfaPendingSecretEncrypted String?  @db.Text
  mfaRecoveryHashes         Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  reservations      Reservation[]
  laundryOrders     LaundryOrder[]
  pushTokens        PushToken[]
  auditLogs         AuditLog[]      @relation("ActorAudit")
  statusChanges     StatusHistory[] @relation("AdminStatusChanges")
  evidenceUploads   EvidencePhoto[] @relation("EvidenceUploader")
  orderMessages     OrderMessage[]  @relation("OrderMessageAuthor")
  adminMachineSlots MachineSlot[]   @relation("AdminMachineSlots")
  consents          UserConsent[]

  @@index([role])
  @@index([lockedUntil])
}

model UserConsent {
  id            String   @id @default(cuid())
  userId        String
  consentType   String   @db.VarChar(50)
  policyVersion String   @db.VarChar(40)
  accepted      Boolean
  textHash      String   @db.VarChar(64)
  source        String   @default("WEB") @db.VarChar(50)
  userAgent     String?  @db.VarChar(300)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType, createdAt])
  @@index([consentType, policyVersion])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  timezone  String   @default("America/Bogota")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  machines      Machine[]
  reservations  Reservation[]
  laundryOrders LaundryOrder[]
  machineSlots  MachineSlot[]

  @@unique([name])
}

model Machine {
  id        String   @id @default(cuid())
  code      String
  branchId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch       Branch        @relation(fields: [branchId], references: [id])
  reservations Reservation[]
  machineSlots MachineSlot[]

  @@unique([branchId, code])
  @@index([branchId])
}

model Reservation {
  id             String            @id @default(cuid())
  requestKey     String?           @unique @db.VarChar(80)
  clientId       String
  branchId       String
  machineId      String
  serviceMode    ServiceMode       @default(SELF_SERVICE)
  cycleType      CycleType
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         ReservationStatus @default(PENDING_PAYMENT)
  amountCents    Int
  notes          String?           @db.VarChar(500)
  paymentId      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client   User         @relation(fields: [clientId], references: [id])
  branch   Branch       @relation(fields: [branchId], references: [id])
  machine  Machine      @relation(fields: [machineId], references: [id])
  payment  Payment?     @relation(fields: [paymentId], references: [id])
  slotLock MachineSlot?

  @@index([clientId, createdAt])
  @@index([machineId, scheduledStart, scheduledEnd])
  @@index([status])
}

model MachineSlot {
  id             String          @id @default(cuid())
  branchId       String
  machineId      String
  type           MachineSlotType
  scheduledStart DateTime
  scheduledEnd   DateTime
  reservationId  String?         @unique
  adminId        String?
  reason         String?         @db.VarChar(300)
  createdAt      DateTime        @default(now())

  branch      Branch       @relation(fields: [branchId], references: [id])
  machine     Machine      @relation(fields: [machineId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  admin       User?        @relation("AdminMachineSlots", fields: [adminId], references: [id])

  @@unique([machineId, scheduledStart, scheduledEnd])
  @@index([branchId, scheduledStart])
  @@index([type, scheduledStart])
}

model LaundryOrder {
  id           String      @id @default(cuid())
  requestKey   String?     @unique @db.VarChar(80)
  clientId     String
  branchId     String?
  serviceMode  ServiceMode @default(DONE_FOR_YOU)
  cycleType    CycleType
  status       OrderStatus @default(QUEUED)
  amountCents  Int
  pickupType   String      @default("STORE")
  address      String?     @db.VarChar(250)
  pieces       Int?
  stainService Boolean     @default(false)
  notes        String?     @db.VarChar(500)
  paymentId    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client         User            @relation(fields: [clientId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  payment        Payment?        @relation(fields: [paymentId], references: [id])
  statusHistory  StatusHistory[]
  evidencePhotos EvidencePhoto[]
  messages       OrderMessage[]

  @@index([clientId, createdAt])
  @@index([branchId])
  @@index([status])
}

model StatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  adminId   String?
  message   String      @db.VarChar(300)
  createdAt DateTime    @default(now())

  order LaundryOrder @relation(fields: [orderId], references: [id])
  admin User?        @relation("AdminStatusChanges", fields: [adminId], references: [id])

  @@index([orderId, createdAt])
}

model OrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  authorId   String
  message    String   @db.VarChar(1000)
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  order  LaundryOrder @relation(fields: [orderId], references: [id])
  author User         @relation("OrderMessageAuthor", fields: [authorId], references: [id])

  @@index([orderId, createdAt])
  @@index([authorId, createdAt])
}

model EvidencePhoto {
  id           String   @id @default(cuid())
  orderId      String
  uploadedById String
  imageUrl     String   @db.VarChar(500)
  mimeType     String   @default("image/jpeg") @db.VarChar(100)
  sizeBytes    Int      @default(0)
  description  String   @db.VarChar(500)
  createdAt    DateTime @default(now())

  order      LaundryOrder @relation(fields: [orderId], references: [id])
  uploadedBy User         @relation("EvidenceUploader", fields: [uploadedById], references: [id])

  @@index([orderId, createdAt])
}

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @db.VarChar(500)
  deviceType String?  @db.VarChar(50)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@index([userId])
}

model Payment {
  id                 String        @id @default(cuid())
  provider           String        @default("WOMPI")
  externalReference  String        @unique
  status             PaymentStatus @default(PENDING)
  amountCents        Int
  currency           String        @default("COP")
  environment        String        @default("sandbox") @db.VarChar(20)
  resourceType       String        @db.VarChar(30)
  resourceId         String        @db.VarChar(191)
  checkoutUrl        String?       @db.VarChar(1000)
  wompiTransactionId String?       @db.VarChar(120)
  rawResponse        Json?
  expiresAt          DateTime?
  processedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  reservations  Reservation[]
  laundryOrders LaundryOrder[]

  @@index([resourceType, resourceId, createdAt])
  @@index([status, expiresAt])
  @@index([wompiTransactionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActorAudit", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date])
}
