# Aplicación
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
DATABASE_URL=mysql://usuario:password@localhost:3306/lavanderia

# Wompi
# sandbox = pruebas / production = dinero real
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR
WOMPI_CURRENCY=COP
WOMPI_CHECKOUT_TTL_MINUTES=15
WOMPI_REDIRECT_URL=http://localhost:3000/client/dashboard?payment=return

# En producción usar el juego prod_* y HTTPS:
# WOMPI_ENVIRONMENT=production
# WOMPI_PUBLIC_KEY=pub_prod_REEMPLAZAR
# WOMPI_PRIVATE_KEY=prv_prod_REEMPLAZAR
# WOMPI_INTEGRITY_SECRET=prod_integrity_REEMPLAZAR
# WOMPI_EVENTS_SECRET=prod_events_REEMPLAZAR
# WOMPI_REDIRECT_URL=https://tu-dominio.com/client/dashboard?payment=return
# URL de eventos a registrar en el dashboard Wompi:
# https://api.tu-dominio.com/api/payments/wompi/webhook

# Firebase (opcional hasta activar evidencias/push)
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
