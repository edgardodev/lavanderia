# Aplicación
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
WEB_ORIGINS=
APP_URL=http://localhost:3000
APP_NAME=La Lavandería & Bakery
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
DATABASE_URL=mysql://usuario:password@localhost:3306/lavanderia

# Resiliencia / capacidad
# Prisma agrega automáticamente connect_timeout=5, pool_timeout=5 y socket_timeout=10
# si no vienen ya definidos en DATABASE_URL.
DB_CONNECTION_LIMIT=10
# Peticiones simultáneas aceptadas por cada instancia antes de responder 503 + Retry-After.
MAX_CONCURRENT_REQUESTS=120
# Las fotos usan memoria temporal; limitar la concurrencia evita picos de RAM.
MAX_CONCURRENT_UPLOADS=6
# Límite de la consulta saliente de verificación a Wompi (3s-15s).
WOMPI_HTTP_TIMEOUT_MS=8000
# Límite base de operaciones salientes a Firebase/Google Cloud (5s-30s).
FIREBASE_OPERATION_TIMEOUT_MS=15000

# Seguridad administrativa
# Generar 32 bytes aleatorios y codificarlos en base64.
MFA_ENCRYPTION_KEY=REEMPLAZAR_BASE64_32_BYTES
# Solo se usa para crear el primer administrador. Después de ejecutar el seed y completar MFA,
# retirar estas variables del entorno si el proveedor de despliegue lo permite.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Versiones legales que quedan registradas con cada consentimiento
PRIVACY_POLICY_VERSION=2026-09-15
TERMS_VERSION=2026-09-15

# Datos legales del responsable (obligatorios en producción)
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ID=
LEGAL_ADDRESS=
LEGAL_PHONE=
PRIVACY_CONTACT_EMAIL=
CUSTOMER_SERVICE_EMAIL=

# Wompi
# sandbox = pruebas / production = dinero real
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR
WOMPI_CURRENCY=COP
WOMPI_CHECKOUT_TTL_MINUTES=15
WOMPI_REDIRECT_URL=http://localhost:3000/client/dashboard?payment=return

# En producción usar el juego prod_* y HTTPS:
# WOMPI_ENVIRONMENT=production
# WOMPI_PUBLIC_KEY=pub_prod_REEMPLAZAR
# WOMPI_PRIVATE_KEY=prv_prod_REEMPLAZAR
# WOMPI_INTEGRITY_SECRET=prod_integrity_REEMPLAZAR
# WOMPI_EVENTS_SECRET=prod_events_REEMPLAZAR
# WOMPI_REDIRECT_URL=https://tu-dominio.com/client/dashboard?payment=return
# URL de eventos a registrar en el dashboard Wompi:
# https://api.tu-dominio.com/api/payments/wompi/webhook

# Firebase / Google Cloud (evidencias y push)
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
